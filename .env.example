# ==============================================================================
# LedgerX Environment Configuration
# Copy this file to .env and configure for your environment
# ==============================================================================

# Application
APP_NAME=LedgerX
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/v1

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=dev-secret-key-please-change-in-production-use-32-chars-minimum

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://ledgerx:ledgerx_secret@localhost:5432/ledgerx
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# Cache TTLs (seconds)
CACHE_TTL_BALANCE=60
CACHE_TTL_WALLET=300
CACHE_TTL_IDEMPOTENCY=86400

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=ledgerx-workers
KAFKA_TOPIC_TRANSACTIONS=ledgerx.transactions
KAFKA_TOPIC_EVENTS=ledgerx.events
KAFKA_TOPIC_AUDIT=ledgerx.audit

# Business Rules
DEFAULT_DAILY_LIMIT=10000.00
DEFAULT_MONTHLY_LIMIT=100000.00
MIN_TRANSACTION_AMOUNT=0.01
MAX_TRANSACTION_AMOUNT=1000000.00
DEFAULT_HOLD_EXPIRY_MINUTES=1440
MAX_HOLD_EXPIRY_MINUTES=10080
MAX_TRANSACTION_RETRIES=3

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_REQUESTS_PER_SECOND=100

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json

# Tracing (Jaeger)
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=1.0

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
